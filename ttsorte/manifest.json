{
  "manifest_version": 3,
  "name": "ttsorte",
  "version": "1.0.0",
  "description": "Ordene vídeos do TikTok por views, curtidas, comentários, compartilhamentos ou data e baixe sem marca d'água.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "ttsorte: abrir/fechar painel", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "downloads"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["src/panel.css"], "matches": ["https://www.tiktok.com/*"] }]
}
